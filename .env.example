# EmailJS Configuration
# Get these values from https://dashboard.emailjs.com/

# Your EmailJS Service ID (from Email Services section)
VITE_EMAILJS_SERVICE_ID=your_service_id

# Your EmailJS Template ID (from Email Templates section)
VITE_EMAILJS_TEMPLATE_ID=your_template_id

# Your EmailJS Auto-Reply Template ID (sends confirmation to user)
VITE_EMAILJS_AUTO_REPLY_TEMPLATE_ID=your_auto_reply_template_id

# Your EmailJS Public Key (from Account > API Keys)
VITE_EMAILJS_PUBLIC_KEY=your_public_key
